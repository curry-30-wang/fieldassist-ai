{
  "id": "finished-goods-dispatch",
  "name": "成品出库/发货记录",
  "category": "销售发运",
  "version": 1,
  "archivePrefix": "CP",
  "fields": [
    {
      "key": "date",
      "label": "日期",
      "dataType": "date",
      "required": true,
      "isSearchable": true
    },
    {
      "key": "customer",
      "label": "客户",
      "dataType": "text",
      "required": true,
      "isSearchable": true
    },
    {
      "key": "projectPart",
      "label": "工程部位",
      "dataType": "text",
      "required": true,
      "isSearchable": true
    },
    {
      "key": "mixType",
      "label": "混合料类型",
      "dataType": "select",
      "required": true,
      "options": [
        "AC",
        "SMA",
        "OGFC"
      ]
    },
    {
      "key": "specification",
      "label": "规格",
      "dataType": "text",
      "required": true,
      "options": [
        "AC-13",
        "AC-16",
        "AC-20",
        "SMA-13"
      ]
    },
    {
      "key": "vehiclePlate",
      "label": "车牌号",
      "dataType": "text",
      "required": true
    },
    {
      "key": "quantity",
      "isSummable": true,
      "label": "发货数量",
      "dataType": "decimal",
      "required": true
    },
    {
      "key": "unitPrice",
      "label": "单价",
      "dataType": "decimal",
      "required": true
    },
    {
      "key": "amountRaw",
      "isSummable": true,
      "label": "金额原值",
      "dataType": "decimal"
    },
    {
      "key": "amount",
      "isSummable": true,
      "label": "发货金额",
      "dataType": "decimal"
    },
    {
      "key": "dispatcher",
      "label": "发货员",
      "dataType": "text"
    },
    {
      "key": "driver",
      "label": "司机",
      "dataType": "text",
      "required": true
    },
    {
      "key": "weighbridgeWeight",
      "isSummable": true,
      "label": "过磅重量",
      "dataType": "decimal",
      "required": true
    },
    {
      "key": "dispatchTime",
      "label": "发货时间",
      "dataType": "text",
      "required": true
    },
    {
      "key": "receivingStatus",
      "label": "签收情况",
      "dataType": "select",
      "required": true,
      "options": [
        "待签收",
        "已签收",
        "异常"
      ]
    }
  ],
  "formulas": [
    {
      "target": "amountRaw",
      "operator": "multiply",
      "operands": [
        "quantity",
        "unitPrice"
      ]
    },
    {
      "target": "amount",
      "operator": "round",
      "operands": [
        "amountRaw"
      ],
      "decimalPlaces": 2
    }
  ],
  "printLayout": {
    "paper": "A4",
    "orientation": "Landscape"
  },
  "searchFields": [
    "date",
    "customer",
    "projectPart"
  ]
}
