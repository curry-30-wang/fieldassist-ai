<Window x:Class="AsphaltPlantManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="沥青拌合站经营管理系统"
        MinWidth="1100"
        MinHeight="700"
        Width="1366"
        Height="768"
        FontFamily="Microsoft YaHei"
        FontSize="14"
        Background="{DynamicResource PageBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F2F6FB" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#102D4F" />
        <SolidColorBrush x:Key="SidebarActiveBrush" Color="#2B76B9" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#18324D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#718198" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2675B8" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#E5F1FC" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#159A8A" />
        <SolidColorBrush x:Key="SuccessLightBrush" Color="#E5F7F3" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D98528" />
        <SolidColorBrush x:Key="WarningLightBrush" Color="#FFF4E4" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C94B58" />
        <SolidColorBrush x:Key="LineBrush" Color="#DFE7F0" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" Color="#23415E" /></Setter.Value></Setter>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.86" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.68" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="{StaticResource SuccessBrush}" /></Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="#E8F0F8" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#D6E3EF" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Margin" Value="8,2" /><Setter Property="Padding" Value="15,11" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#D5E4F4" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{StaticResource SidebarActiveBrush}" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style>

        <Style x:Key="InputBox" TargetType="TextBox"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#C9D7E5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,8" /><Setter Property="Margin" Value="0,0,10,0" /></Style>
        <Style x:Key="InputComboBox" TargetType="ComboBox"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#C9D7E5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="8,6" /><Setter Property="Margin" Value="0,0,10,0" /></Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
        <Style x:Key="DataGridStyle" TargetType="DataGrid"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="#E8EEF4" /><Setter Property="RowBackground" Value="White" /><Setter Property="AlternatingRowBackground" Value="#F8FBFE" /><Setter Property="HeadersVisibility" Value="Column" /><Setter Property="CanUserResizeRows" Value="False" /></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EAF2F9" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="12,10" /><Setter Property="BorderBrush" Value="#D5E2EE" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
        <DataTemplate x:Key="FieldEditorTemplate"><Grid><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="5" /><ComboBox ItemsSource="{Binding Definition.Options}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsSelect, Converter={StaticResource BoolToVisibility}}" Padding="3" /></Grid></DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="238" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"><Border Padding="22,26,22,22" BorderBrush="#27496C" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="沥青拌合站" Foreground="White" FontSize="22" FontWeight="Bold" /><TextBlock Text="经营管理系统" Foreground="#AFC9E3" FontSize="13" Margin="1,5,0,0" /><Border Background="#1C446D" CornerRadius="6" Padding="8,5" HorizontalAlignment="Left" Margin="0,16,0,0"><TextBlock Text="单机版 · Excel 工作流" Foreground="#D9ECFF" FontSize="11" /></Border></StackPanel></Border></StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="数据保存在本机" Foreground="#89A8C7" FontSize="11" Margin="24,18,24,20" />
                <ListBox ItemsSource="{Binding NavigationItems}" Background="Transparent" BorderThickness="0" Foreground="White" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Group}" Visibility="{Binding ShowGroupHeader, Converter={StaticResource BoolToVisibility}}" Foreground="#7898B9" FontSize="11" FontWeight="SemiBold" Margin="24,16,12,4" /><Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Title}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Width="28" FontSize="18" VerticalAlignment="Center" /><TextBlock Text="{Binding Title}" VerticalAlignment="Center" /></StackPanel></Button></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Margin="28,20,28,18">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,14" Margin="0,0,0,20"><Grid><StackPanel><TextBlock Text="{Binding CurrentPage}" FontSize="14" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="经营管理工作台" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" /></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Settings.CompanyName, TargetNullValue=未设置公司名称}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="单机离线 · 数据安全保存在本机" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" /></StackPanel></Grid></Border>
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,18,0,0"><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" /></Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ContentControl><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="首页"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ContentControl.Style>
                        <StackPanel><Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="经营总览" Style="{StaticResource PageTitle}" /><TextBlock Text="今天的生产、库存和档案情况一目了然" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" /></StackPanel><Button Content="刷新数据" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding Dashboard.RefreshCommand}" /></Grid>
                            <UniformGrid Columns="4" Margin="0,0,0,18"><Border Style="{StaticResource CardStyle}" BorderBrush="#BBDDF3" BorderThickness="1,3,1,1" Margin="0,0,12,0"><StackPanel><TextBlock Text="今日产量" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Dashboard.TodayProduction, StringFormat={}{0:N2}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,2"/><TextBlock Text="生产记录汇总" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" BorderBrush="#BEE9E2" BorderThickness="1,3,1,1" Margin="0,0,12,0"><StackPanel><TextBlock Text="沥青消耗" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Dashboard.TodayConsumption, StringFormat={}{0:N2}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,2"/><TextBlock Text="今日消耗量" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" BorderBrush="#C8DDF4" BorderThickness="1,3,1,1" Margin="0,0,12,0"><StackPanel><TextBlock Text="当前库存" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Dashboard.CurrentInventory, StringFormat={}{0:N2}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,2"/><TextBlock Text="沥青库存余额" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" BorderBrush="#F0D8B6" BorderThickness="1,3,1,1"><StackPanel><TextBlock Text="应收账款" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Dashboard.AccountsReceivable, StringFormat={}{0:N2}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,2"/><TextBlock Text="待跟进金额" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border></UniformGrid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,16"><StackPanel><TextBlock Text="快捷操作" Style="{StaticResource SectionTitle}"/><Button Content="＋  新建 Excel 表格" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="新建表格" HorizontalAlignment="Left"/><Button Content="▣  查询历史档案" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateCommand}" CommandParameter="档案" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock Text="从模板生成、填写和封存都在 Excel 中完成。" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Background="{StaticResource WarningLightBrush}" BorderBrush="#F1D4A9"><StackPanel><TextBlock Text="运行提醒" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Dashboard.Reminder}" Foreground="{StaticResource WarningBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="请根据提醒及时检查库存、设备保养或应收账款。" Foreground="#8B6B43" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
                            <Border Style="{StaticResource CardStyle}" Padding="20,18,20,12"><StackPanel><TextBlock Text="最近档案" Style="{StaticResource SectionTitle}"/><DataGrid ItemsSource="{Binding Dashboard.RecentRecords}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource DataGridStyle}" MinHeight="180"><DataGrid.Columns><DataGridTextColumn Header="模板" Binding="{Binding TemplateId}" Width="*"/><DataGridTextColumn Header="期间" Binding="{Binding PeriodStart}" Width="150"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="档案号" Binding="{Binding ArchiveNumber}" Width="180"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="新建表格"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ContentControl.Style>
                        <StackPanel><TextBlock Text="新建表格" Style="{StaticResource PageTitle}"/><TextBlock Text="选择模板后，在 Excel 中完成全部表格编辑和打印" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="第一步：选择表格和期间" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,18,0"><TextBlock Text="表格模板" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/><ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding NewForm.Templates}" SelectedItem="{Binding NewForm.SelectedTemplate}" DisplayMemberPath="Name"/><Button Content="收藏/取消收藏当前模板" Style="{StaticResource SecondaryButton}" Command="{Binding NewForm.ToggleTemplateFavoriteCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="开始日期" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/><DatePicker SelectedDate="{Binding NewForm.PeriodStart}" Padding="8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="结束日期" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/><DatePicker SelectedDate="{Binding NewForm.PeriodEnd}" Padding="8"/></StackPanel></Grid></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="第二步：在 Excel 中填写" Style="{StaticResource SectionTitle}"/><UniformGrid Columns="3" Margin="0,0,0,18"><StackPanel Margin="0,0,12,0"><Border Background="{StaticResource AccentLightBrush}" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Left"><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="生成模板" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,2"/><TextBlock Text="自动打开标准 Excel 文件" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/></StackPanel><StackPanel Margin="0,0,12,0"><Border Background="{StaticResource SuccessLightBrush}" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Left"><TextBlock Text="2" Foreground="{StaticResource SuccessBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="自由编辑" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,2"/><TextBlock Text="列宽、公式、规格和打印均可调整" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/></StackPanel><StackPanel><Border Background="{StaticResource WarningLightBrush}" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Left"><TextBlock Text="3" Foreground="{StaticResource WarningBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="导入封存" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,2"/><TextBlock Text="软件校验后生成档案编号" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></UniformGrid><StackPanel Orientation="Horizontal"><Button Content="在 Excel 中填写" Style="{StaticResource PrimaryButton}" Command="{Binding NewForm.CreateExcelDraftCommand}"/><Button Content="导入 Excel 并预览" Style="{StaticResource SuccessButton}" Command="{Binding NewForm.ImportExcelAndSealCommand}"/><Button Content="打开草稿文件夹" Style="{StaticResource SecondaryButton}" Command="{Binding NewForm.OpenDraftFolderCommand}"/><TextBox Style="{StaticResource InputBox}" Width="180" Text="{Binding NewForm.ChangeNote}" ToolTip="封存说明"/></StackPanel><TextBlock Text="{Binding NewForm.Message}" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/><Border Background="{StaticResource AccentLightBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0" Visibility="{Binding NewForm.HasImportPreview, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="Excel 预览" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="{Binding NewForm.PreviewSummary}" Foreground="{StaticResource TextBrush}" Margin="0,6,0,8" TextWrapping="Wrap"/><Button Content="确认并封存" Style="{StaticResource SuccessButton}" Command="{Binding NewForm.ConfirmImportAndSealCommand}" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="常用规格：" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4"/><ItemsControl ItemsSource="{Binding NewForm.SpecificationSuggestions}" Height="30"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F0F4F8" CornerRadius="10" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="{Binding}" Foreground="{StaticResource MutedTextBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="最近 Excel 草稿" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,12,0,4"/><ListBox ItemsSource="{Binding NewForm.RecentDrafts}" Height="92" BorderBrush="{StaticResource LineBrush}"><ListBox.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.NewForm.OpenRecentDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"/></DataTemplate></ListBox.ItemTemplate></ListBox><ItemsControl ItemsSource="{Binding NewForm.ValidationMessages}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><DataGrid Visibility="Collapsed" ItemsSource="{Binding NewForm.Fields}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="字段" Binding="{Binding Definition.Label}"/><DataGridTextColumn Header="类型" Binding="{Binding Definition.DataType}"/><DataGridTemplateColumn Header="值" CellTemplate="{StaticResource FieldEditorTemplate}"/></DataGrid.Columns></DataGrid>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="档案"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ContentControl.Style>
                        <StackPanel><TextBlock Text="档案查询与输出" Style="{StaticResource PageTitle}"/><TextBlock Text="按条件精确查找已封存记录，并进行版本、打印和导出操作" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="查询条件" Style="{StaticResource SectionTitle}"/><WrapPanel><DatePicker SelectedDate="{Binding Archive.FromDate}" Padding="8" Margin="0,0,10,8"/><DatePicker SelectedDate="{Binding Archive.ToDate}" Padding="8" Margin="0,0,10,8"/><TextBox Style="{StaticResource InputBox}" Width="115" Text="{Binding Archive.TemplateId}" ToolTip="模板 ID"/><TextBox Style="{StaticResource InputBox}" Width="115" Text="{Binding Archive.Customer}" ToolTip="客户"/><TextBox Style="{StaticResource InputBox}" Width="115" Text="{Binding Archive.Project}" ToolTip="工程"/><TextBox Style="{StaticResource InputBox}" Width="115" Text="{Binding Archive.Specification}" ToolTip="规格"/><TextBox Style="{StaticResource InputBox}" Width="140" Text="{Binding Archive.Keyword}" ToolTip="关键词"/><Button Content="查询档案" Style="{StaticResource PrimaryButton}" Command="{Binding Archive.SearchCommand}"/></WrapPanel></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Padding="20,18,20,12"><StackPanel><TextBlock Text="查询结果" Style="{StaticResource SectionTitle}"/><DataGrid ItemsSource="{Binding Archive.Results}" SelectedItem="{Binding Archive.SelectedResult}" AutoGenerateColumns="False" Style="{StaticResource DataGridStyle}" MinHeight="220"><DataGrid.Columns><DataGridTextColumn Header="档案号" Binding="{Binding ArchiveNumber}" Width="180"/><DataGridTextColumn Header="模板" Binding="{Binding TemplateId}" Width="*"/><DataGridTextColumn Header="客户" Binding="{Binding Customer}" Width="140"/><DataGridTextColumn Header="工程" Binding="{Binding Project}" Width="140"/><DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="150"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,24,0"><TextBlock Text="历史版本（只保留最近两版）" Style="{StaticResource SectionTitle}"/><ListBox ItemsSource="{Binding Archive.Versions}" SelectedItem="{Binding Archive.SelectedVersion}" DisplayMemberPath="Version" Height="110" BorderBrush="{StaticResource LineBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="操作" Style="{StaticResource SectionTitle}"/><WrapPanel><TextBox Style="{StaticResource InputBox}" Width="150" Text="{Binding Archive.Password}" ToolTip="本会话解锁密码"/><Button Content="解锁档案" Style="{StaticResource SecondaryButton}" Command="{Binding Archive.UnlockCommand}"/><Button Content="打印预览" Style="{StaticResource SecondaryButton}" Command="{Binding Archive.PreviewCommand}"/><Button Content="打印" Style="{StaticResource PrimaryButton}" Command="{Binding Archive.PrintCommand}"/><Button Content="导出 Excel" Style="{StaticResource SecondaryButton}" Command="{Binding Archive.ExportExcelCommand}"/><Button Content="导出可编辑 Excel" Style="{StaticResource SecondaryButton}" Command="{Binding Archive.ExportEditableExcelCommand}"/><Button Content="导入修改后的 Excel" Style="{StaticResource SuccessButton}" Command="{Binding Archive.ImportEditableExcelCommand}"/><Button Content="导出 PDF" Style="{StaticResource SecondaryButton}" Command="{Binding Archive.ExportPdfCommand}"/></WrapPanel><TextBlock Text="{Binding Archive.Message}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0"/></StackPanel></Grid></Border>
                        </StackPanel>
                    </ContentControl>

    <ContentControl><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="客户欠款"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ContentControl.Style><StackPanel><TextBlock Text="客户欠款" Style="{StaticResource PageTitle}"/><TextBlock Text="单独登记客户欠款，不需要每次生产都录入" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="欠款清单" Style="{StaticResource SectionTitle}"/><WrapPanel><TextBox Style="{StaticResource InputBox}" Width="220" Text="{Binding Receivables.SearchCustomer}" ToolTip="客户名称"/><Button Content="查询" Style="{StaticResource PrimaryButton}" Command="{Binding Receivables.SearchCommand}"/><Button Content="新增一条" Style="{StaticResource SecondaryButton}" Command="{Binding Receivables.ClearEditorCommand}"/><TextBlock Text="当前剩余欠款：" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/><TextBlock Text="{Binding Receivables.TotalRemaining, StringFormat={}{0:N2} 元}" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" VerticalAlignment="Center"/></WrapPanel><DataGrid ItemsSource="{Binding Receivables.Items}" SelectedItem="{Binding Receivables.SelectedItem}" AutoGenerateColumns="False" Style="{StaticResource DataGridStyle}" MinHeight="220" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="应收" Binding="{Binding ReceivableAmount, StringFormat={}{0:N2}}" Width="120"/><DataGridTextColumn Header="已收" Binding="{Binding PaidAmount, StringFormat={}{0:N2}}" Width="120"/><DataGridTextColumn Header="剩余欠款" Binding="{Binding RemainingAmount, StringFormat={}{0:N2}}" Width="120"/><DataGridTextColumn Header="收款状态" Binding="{Binding StatusText}" Width="110"/><DataGridTextColumn Header="收款日期" Binding="{Binding DueDate}" Width="130"/><DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="新增或修改" Style="{StaticResource SectionTitle}"/><WrapPanel><TextBox Style="{StaticResource InputBox}" Width="180" Text="{Binding Receivables.CustomerName}" ToolTip="客户名称"/><TextBox Style="{StaticResource InputBox}" Width="120" Text="{Binding Receivables.ReceivableAmount}" ToolTip="应收金额"/><TextBox Style="{StaticResource InputBox}" Width="120" Text="{Binding Receivables.PaidAmount}" ToolTip="已收金额"/><DatePicker SelectedDate="{Binding Receivables.DueDate}" Padding="8"/><TextBox Style="{StaticResource InputBox}" Width="220" Text="{Binding Receivables.Note}" ToolTip="备注"/><Button Content="保存欠款" Style="{StaticResource PrimaryButton}" Command="{Binding Receivables.SaveCommand}"/><Button Content="删除选中" Style="{StaticResource SecondaryButton}" Command="{Binding Receivables.DeleteCommand}"/><Button Content="导出客户对账 Excel" Style="{StaticResource SecondaryButton}" Command="{Binding Receivables.ExportSelectedCommand}"/></WrapPanel><TextBlock Text="{Binding Receivables.Message}" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ContentControl>

                    <ContentControl><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="基础资料"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ContentControl.Style><StackPanel><TextBlock Text="基础资料" Style="{StaticResource PageTitle}"/><TextBlock Text="客户、供应商、车辆和司机可以在 Excel 中下拉选择，也可以随时新增" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="资料维护" Style="{StaticResource SectionTitle}"/><WrapPanel><ComboBox Style="{StaticResource InputComboBox}" Width="130" ItemsSource="{Binding MasterData.Categories}" SelectedItem="{Binding MasterData.Category}"/><TextBox Style="{StaticResource InputBox}" Width="200" Text="{Binding MasterData.Key}" ToolTip="名称"/><TextBox Style="{StaticResource InputBox}" Width="320" Text="{Binding MasterData.Value}" ToolTip="值或备注"/><Button Content="读取" Style="{StaticResource SecondaryButton}" Command="{Binding MasterData.LoadItemCommand}"/><Button Content="保存资料" Style="{StaticResource PrimaryButton}" Command="{Binding MasterData.SaveCommand}"/><Button Content="删除资料" Style="{StaticResource SecondaryButton}" Command="{Binding MasterData.DeleteCommand}"/></WrapPanel><ListBox ItemsSource="{Binding MasterData.Items}" SelectedItem="{Binding MasterData.SelectedItem}" DisplayMemberPath="Key" Height="110" Margin="0,12,0,0" BorderBrush="{StaticResource LineBrush}"/><TextBlock Text="{Binding MasterData.Message}" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ContentControl>

                    <ContentControl><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="备份"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ContentControl.Style><StackPanel><TextBlock Text="备份与恢复" Style="{StaticResource PageTitle}"/><TextBlock Text="建议定期创建备份，并将重要备份复制到 U 盘或其他硬盘" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="创建备份" Style="{StaticResource SectionTitle}"/><TextBlock Text="备份目录" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Style="{StaticResource InputBox}" Text="{Binding Backup.DestinationRoot}" Margin="0,0,0,12"/><Button Content="手动创建备份" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding Backup.CreateCommand}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Background="{StaticResource WarningLightBrush}" BorderBrush="#F1D4A9"><StackPanel><TextBlock Text="恢复数据" Style="{StaticResource SectionTitle}"/><TextBlock Text="备份文件路径" Foreground="#8B6B43" Margin="0,0,0,6"/><TextBox Style="{StaticResource InputBox}" Text="{Binding Backup.BackupPath}" Margin="0,0,0,12"/><WrapPanel><Button Content="验证备份" Style="{StaticResource SecondaryButton}" Command="{Binding Backup.ValidateCommand}"/><CheckBox Content="我已理解恢复会覆盖当前数据" IsChecked="{Binding Backup.RestoreConfirmed}" VerticalAlignment="Center" Margin="6,0,14,0"/><Button Content="从备份恢复" Style="{StaticResource PrimaryButton}" Command="{Binding Backup.RestoreCommand}"/></WrapPanel><TextBlock Text="{Binding Backup.Message}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ContentControl>

                    <ContentControl><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="设置"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ContentControl.Style><StackPanel><TextBlock Text="设置" Style="{StaticResource PageTitle}"/><TextBlock Text="修改公司名称和本次会话的封存解锁密码" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="公司信息" Style="{StaticResource SectionTitle}"/><TextBlock Text="公司名称" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Style="{StaticResource InputBox}" Width="380" Text="{Binding Settings.CompanyName}"/><Button Content="保存公司名称" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding Settings.SaveCompanyCommand}"/><TextBlock Text="修改后会显示在顶部标题栏和 Excel 模板中。" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="封存解锁密码" Style="{StaticResource SectionTitle}"/><TextBlock Text="本次启动后第一次修改已封存档案时输入，之后可继续修改。" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/><PasswordBox Width="380" Padding="10,8" PasswordChanged="PasswordBox_OnPasswordChanged"/><Button Content="更新解锁密码" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding Settings.SetPasswordCommand}"/><TextBlock Text="{Binding Settings.Message}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ContentControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
